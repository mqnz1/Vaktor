# Copie este arquivo para .env e preencha apenas as chaves que for usar.
# Nunca versione o .env real.

# Numes (catálogo free local; true reativa o catálogo remoto)
NUMES_API_KEY=
NUMES_DYNAMIC_MODELS=false

# Qronos AI (free tier)
QRONOS_API_KEY=

# Zro (DeepSeek/GLM/Dolly/Abyss)
ZRO_API_KEY=

# UnoRouter (todos os LLMs :free de texto)
UNOROUTER_API_KEY=

# Vyce AI (chave principal e pool opcional separado por vírgula)
VYCEAI_API_KEY=
VYCEAI_API_KEYS=
# Alias legado aceito pelo provider
VYCEAI_API_KEY_POOL=
