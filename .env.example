# Vaktor - exemplo de configuracao
# Copie este arquivo para .env e preencha apenas as chaves que for usar.
# NUNCA commit o .env: ele contem suas credenciais.
# Lista completa de variaveis: README.md > Configuracao (.env)

# --- Roteamento ---
DEFAULT_MODEL=auto
# FALLBACK_MODEL=claude-haiku-4-5-20251001
CREDIT_BUDGET_USD=1.0
MAX_TOKENS_PER_REQUEST=4096
MAX_CONTEXT_MESSAGES=20
CONTEXT_BUDGET_TOKENS=24000
ENABLE_RESPONSE_CACHE=true
PREFER_FREE_MODELS=true
AUTO_FALLBACK=false

# --- Provedores (deixe vazio para desativar) ---
PUTER_API_KEY=
AGENTROUTER_API_KEY=
OPENROUTER_API_KEY=
REQUESTY_API_KEY=
NUMES_API_KEY=
KILO_API_KEY=
FTAI_API_KEY=
GROQ_API_KEY=
ECHO_API_KEY=
ECHO_API_KEY_POOL=
NVIDIA_API_KEY=
OPENCODE_API_KEY=
HARBOR_API_KEY=
ITERACOMPUTE_API_KEY=
QODER_API_KEY=
QRONOS_API_KEY=
ZRO_API_KEY=
UNOROUTER_API_KEY=
APINEX_API_KEY=
VYCEAI_API_KEY=
DEEPAI_API_KEY=
DEEPAI_CODE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NOTION_API_KEY=
NOTION_COOKIE=
NOTION_TOKEN_V2=
NIGHTROUTER_API_KEY=
NIGHTROUTER_API_KEY_POOL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agente ---
ENABLE_AGENT=true
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=20
TOOLS_ALLOW_WRITE=true
TOOLS_AUTO_APPROVE=false
TOOLS_ALLOW_NETWORK=true
TOOLS_ALLOW_INSTALL=false
TOOLS_ALLOW_GIT_WRITE=false
TOOLS_ALLOWED_COMMANDS=
TOOLS_ALLOWED_DOMAINS=
VERIFY_ENABLED=true
VERIFY_MAX_ATTEMPTS=3
CONTEXT_INJECT=true
CONTEXT_MAX_CHARS=4000
MEMORY_FILE=VAKTOR.md

# --- Seguranca ---
SECURITY_ENABLED=false
SECURITY_FILE=SECURITY.md

# --- MCP ---
MCP_ENABLED=false
MCP_SERVERS=

# --- Extras ---
ENABLE_SKILLS=true
SKILLS_MAX_PROMPT_CHARS=3200
SKILLS_MAX_PER_REQUEST=3
ENABLE_THINKING=false
THINKING_MODE=auto
THINKING_MIN_COMPLEXITY=normal
THINKING_BUDGET_TOKENS=8000
THINKING_MAX_PASSES=1
THINKING_SHOW=false
BEST_OF_N=1
CRITIC_MODEL=
BEST_OF_N_MAX_COST_USD=0.05
ENABLE_DATASET_LOG=false
RESOURCES_ENABLED=true
RESOURCES_FILE=RESOURCES.md
RUNTIME_CONTEXT=true

# --- Notion Web (opcional) ---
# NOTION_COOKIE_AUTO=true
# NOTION_COOKIE_BROWSER=firefox
# NOTION_SPACE_ID=
# NOTION_WEB_BASE_URL=https://app.notion.com
# NOTION_WEB_WORKFLOW_ID=
