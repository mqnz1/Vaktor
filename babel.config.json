{
  "presets": [
    [
      "babel-preset-solid",
      {
        "moduleName": "@opentui/solid",
        "generate": "universal"
      }
    ],
    [
      "@babel/preset-typescript",
      {
        "onlyRemoveTypeImports": true
      }
    ]
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "alias": {
          "solid-js": "solid-js/dist/solid.js",
          "solid-js/store": "solid-js/store/dist/store.js"
        }
      }
    ]
  ]
}
